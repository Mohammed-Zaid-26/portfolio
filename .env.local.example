# Telegram Bot API — required for the contact form to deliver messages
# 1. Message @BotFather on Telegram, run /newbot, copy the token it gives you.
# 2. Message your new bot once (any text), then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the numeric "chat":{"id": ...} value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=
